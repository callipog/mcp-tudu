{
  "name": "mcp-tudu",
  "version": "1.0.0",
  "type": "module",
  "description": "Servidor MCP que deixa assistentes de IA criarem projetos, épicos e tarefas no TuDu.",
  "main": "index.js",
  "bin": {
    "mcp-tudu": "index.js"
  },
  "scripts": {
    "build:bundle": "esbuild index.js --bundle --platform=node --format=cjs --target=node18 --outfile=build/mcp-tudu.cjs",
    "build:exe": "npm run build:bundle && pkg build/mcp-tudu.cjs --targets node22-win-x64 --output build/mcp-tudu.exe"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/callipog/mcp-tudu.git"
  },
  "author": {
    "name": "Guilherme Callipo",
    "email": "guilhermecallipo@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0",
    "esbuild": "^0.28.1"
  }
}
